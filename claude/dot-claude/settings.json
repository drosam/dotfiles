{
  "permissions": {
    "allow": [
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec cucumber:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git log:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(pwd:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run eslint:*)",
      "Bash(bin/rspec:*)",
      "Bash(bin/system-test:*)",
      "Bash(bin/cucumber:*)",
      "Bash(BROWSER=headless_chrome bin/cucumber:*)",
      "Bash(BROWSER=headless_chrome bundle exec cucumber:*)",
      "Bash(git checkout *)",
      "Bash(bin/rubocop -a app/interactors/line/sync_taxes_and_prices.rb spec/interactors/line/sync_taxes_and_prices_spec.rb)",
      "Skill(update-config)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/session-autorename.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/session-set-title.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.tmux/scripts/agent-attention.sh off"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.tmux/scripts/agent-attention.sh on"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input|agent_completed",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.tmux/scripts/agent-attention.sh on"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.tmux/scripts/agent-attention.sh on"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true,
    "caveman@caveman": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen"
}
