#!/usr/bin/env bash
set -euo pipefail

repo_dir="${DOTFILES_DIR:-$HOME/Developer/dotfiles}"
cd "$repo_dir"

# ~/.zshrc is commonly created by oh-my-zsh. Remove it so stow can own the link.
rm -f "$HOME/.zshrc"

# ~/.claude/settings.json is created by Claude Code on first run. Remove it
# so stow can own the link; other ~/.claude state is left untouched.
rm -f "$HOME/.claude/settings.json"

# ~/.config/herdr also holds sockets, logs and sessions. Create it so stow
# links config.toml only instead of folding the whole directory into the repo.
mkdir -p "$HOME/.config/herdr"

# Docker/dev containers do not need GUI app config.
if [ -f /.dockerenv ]; then
  folders=(
    "delta"
    "gitconfig"
    "nvim"
    "tmux"
    "tmuxinator"
    "zshrc"
    "bin"
    "starship"
    "opencode"
    "lazygit"
    "pi"
    "skills"
    "agents"
    "claude"
  )
else
  folders=(
    "alacritty"
    "ghostty"
    "delta"
    "gitconfig"
    "nvim"
    "skhd"
    "herdr"
    "tmux"
    "tmuxinator"
    "zshrc"
    "bin"
    "starship"
    "opencode"
    "lazygit"
    "pi"
    "skills"
    "agents"
    "claude"
  )
fi

stow --dotfiles -t "$HOME" "${folders[@]}"

if command -v npm >/dev/null; then
  npm ci --prefix "$repo_dir/pi/dot-pi/agent/extensions/web-tools"
else
  printf 'npm not found; skipping Pi web-tools dependencies\n' >&2
fi

mkdir -p "$HOME/.claude/skills"
for skill_dir in "$HOME/.agents/skills/"* "$HOME/.pi/agent/skills/"*; do
  [ -f "$skill_dir/SKILL.md" ] || continue
  target="$HOME/.claude/skills/${skill_dir##*/}"

  if [ -L "$target" ] && [ "$target" -ef "$skill_dir" ]; then
    continue
  fi
  if [ -e "$target" ] || [ -L "$target" ]; then
    printf 'Claude skill link conflict: %s (expected %s)\n' "$target" "$skill_dir" >&2
    exit 1
  fi

  ln -s "$skill_dir" "$target"
done
